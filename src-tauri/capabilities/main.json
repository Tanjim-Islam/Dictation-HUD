{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: settings, history, and management.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "updater:default",
    "process:allow-restart",
    "allow-session-intent",
    "allow-session-snapshot",
    "allow-set-hotkey",
    "allow-get-hotkey",
    "allow-set-autostart",
    "allow-get-autostart",
    "allow-log-to-terminal",
    "allow-get-settings",
    "allow-update-settings",
    "allow-providers-overview",
    "allow-set-provider-key",
    "allow-clear-provider-key",
    "allow-test-provider",
    "allow-list-refine-models",
    "allow-elevenlabs-pool-view",
    "allow-elevenlabs-pool-add",
    "allow-elevenlabs-pool-remove",
    "allow-elevenlabs-pool-clear",
    "allow-elevenlabs-pool-set-multi",
    "allow-elevenlabs-pool-refresh",
    "allow-elevenlabs-pool-watch",
    "allow-audio-devices"
  ]
}