{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictation HUD",
  "version": "2.0.0",
  "identifier": "com.r0ju.dictationhud",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyOUM5QTA3REMwQTA4NwpSV1NIb01COW9Na3BDQXhvTmZyWHREL2RDQkV1a0JDaUwwZDRRNW5seDB4aytEZkpITllDMjhlMwo=",
      "endpoints": [
        "https://github.com/Tanjim-Islam/Dictation-HUD/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dictation HUD",
        "width": 1334,
        "height": 841,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "flowbar",
        "title": "Flow Bar",
        "url": "#/flowbar",
        "width": 100,
        "height": 28,
        "center": false,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focusable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
